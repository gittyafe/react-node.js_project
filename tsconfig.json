{
  "compilerOptions": {
    "target": "es2022",                          // שינוי: תמיכה בקוד JavaScript מודרני
    "module": "commonjs",
    "lib": ["es2022"],
    "allowJs": true,
    "outDir": "./dist",
    "rootDir": "./server/src",                  // שינוי: מכוון את השרת לתיקיית הקוד האמיתית שלך
    "strict": true,
    "strictPropertyInitialization": false,      // שינוי: מונע שגיאות על שדות ריקים של ה-DB (כמו id)
    "esModuleInterop": true,
    "experimentalDecorators": true,             // שינוי: מפעיל תמיכה בשטרודלים (@Entity)
    "emitDecoratorMetadata": true,              // שינוי: מפעיל תמיכה במטה-דאטה עבור TypeORM
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["server/src/**/*"]                // שינוי: אומר ל-TypeScript אילו קבצים לקרוא
}